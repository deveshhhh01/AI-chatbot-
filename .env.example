# ========================================================
# DarGlobal & Wasalt AI Real Estate Intelligence Chatbot
# Environment Configuration
# ========================================================

# LLM Provider Selection: "gemini" (default) or "openrouter"
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Assignment Alternative Provider)
# Get your API key from OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=backend/data/vector_db
CHROMA_COLLECTION_NAME=real_estate_knowledge

# Application Database (SQLite)
SQLITE_DB_PATH=backend/data/app_metadata.db

# Storage Directories
RAW_DATA_DIR=backend/data/raw
PROCESSED_DATA_DIR=backend/data/processed

# Retrieval Settings
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Admin Endpoint Security
ADMIN_SECRET_KEY=darglobal-admin-secret-2026

# Server Port
PORT=8000
